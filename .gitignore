*.crdownload
*.part
*.tmp

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- LaTeX (fichiers auxiliaires de compilation) ---
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.toc
build.log

